# Auth between KRVE website and this backend.
DIGITAL_TWIN_API_KEY=change-me

# Public URL of this service after deployment.
# Example:
# https://digital-twin.example.com
DIGITAL_TWIN_PUBLIC_BASE_URL=

# Comma-separated browser origins if you later call
# this API directly from the browser.
DIGITAL_TWIN_ALLOWED_ORIGINS=http://localhost:3000

# Persistent storage directory.
DIGITAL_TWIN_DATA_ROOT=./data

# Maximum individual upload size.
DIGITAL_TWIN_MAX_IMAGE_BYTES=12582912

# IMPORTANT:
# This is the actual reconstruction engine command.
# Until this is configured, the API will NEVER
# fabricate a fake avatar.
#
# Supported placeholders:
# {front}
# {side}
# {height}
# {output}
# {session}
#
# Example:
# DIGITAL_TWIN_ENGINE_COMMAND=python engine/run.py --front "{front}" --side "{side}" --height "{height}" --output "{output}" --session "{session}"
DIGITAL_TWIN_ENGINE_COMMAND=

DIGITAL_TWIN_ENGINE_TIMEOUT_SECONDS=900
